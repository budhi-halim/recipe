  "steps": [
    [
      "Prepare",
      "Mince garlic, grate ginger and slice shallots. Whisk white miso, regular soy, dark soy, oyster sauce and rice vinegar together."
    ],
    [
      "Brown the pork",
      "Heat neutral oil in a broad pan. Brown minced pork thoroughly, breaking it into small pieces. Remove it briefly if needed to avoid overcrowding."
    ],
    [
      "Cook the aromatics",
      "In the same pan, cook the shallots, garlic and ginger until fragrant. Add the five-spice powder briefly without burning it."
    ],
    [
      "Reduce the mirin",
      "Pour in mirin and simmer for 3–5 minutes to soften its alcoholic taste. Return the pork and add the mixed sauce; simmer gently for 2–3 minutes."
    ],
    [
      "Cook the noodles",
      "Boil the noodles until just firm. Reserve cooking water, then drain without rinsing."
    ],
    [
      "Toss and serve",
      "Toss noodles with the pork and sauce over low heat, adding reserved noodle water little by little until glossy. Finish with optional sesame oil, fried shallots or soft-boiled eggs."
    ]
  ],
  "notes": [
    "The five-spice should be subtle and not dominate the dish.",
    "Reserved noodle water is an allowance, not a mandatory amount; use only what is needed for a light gloss.",
    "This recipe is intentionally non-spicy."
  ]
