  "steps": [
    [
      "Prepare the broth",
      "Heat the water with dashi powder to a gentle simmer. Follow the dashi package's instructions for strength."
    ],
    [
      "Cook the beef",
      "Quickly sear thin beef in the oil, add soy sauce and mirin, and optionally ginger and sugar. Simmer briefly to reduce the mirin's alcoholic edge. Very thin shabu-style slices can instead be poached gently in the broth until cooked."
    ],
    [
      "Cook the udon",
      "Loosen or cook udon according to the package. Divide among six warmed bowls."
    ],
    [
      "Finish the broth",
      "Warm optional tofu and wakame in the dashi. Turn off the heat, dissolve miso in a small amount of broth, then stir it back in without boiling."
    ],
    [
      "Assemble",
      "Pour the miso broth over udon. Top with the beef and green onions. Serve promptly."
    ]
  ],
  "notes": [
    "Avoid overcooking paper-thin beef.",
    "Miso should be added off the heat, and the finished broth should remain gently savoury rather than excessively salty."
  ]
}
